<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TallerFlow.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/tf_input_fill</item>
        <item name="boxStrokeColor">@color/tf_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="hintTextColor">@color/tf_accent</item>
        <item name="android:textColorHint">@color/tf_text_hint</item>
        <item name="startIconTint">@color/tf_text_secondary</item>
        <item name="endIconTint">@color/tf_text_secondary</item>
        <item name="errorTextColor">#FF8A80</item>
        <item name="boxStrokeErrorColor">#FF8A80</item>
        <item name="hintTextAppearance">@style/TallerFlow.HintText</item>
    </style>

    <style name="TallerFlow.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/tf_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textCursorDrawable">@drawable/cursor_accent</item>
    </style>

    <style name="TallerFlow.HintText" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

</resources>
