rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function noAnonimo() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function textoValido(valor, maximo) {
      return valor is string && valor.trim().size() > 0 && valor.size() <= maximo;
    }

    function textoOpcional(valor, maximo) {
      return valor is string && valor.size() <= maximo;
    }

    function clienteValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'uid', 'nombre', 'apellido', 'rut', 'telefono', 'email'])
        && d.id is int
        && textoValido(d.nombre, 60)
        && textoValido(d.apellido, 60)
        && textoValido(d.rut, 12)
        && textoValido(d.telefono, 20)
        && textoOpcional(d.email, 80);
    }

    function repuestoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'uid', 'nombre', 'codigo', 'categoria', 'precio', 'stock'])
        && d.id is int
        && textoValido(d.nombre, 60)
        && textoValido(d.codigo, 30)
        && textoValido(d.categoria, 40)
        && d.precio is int && d.precio > 0 && d.precio <= 10000000
        && d.stock is int && d.stock >= 0 && d.stock <= 100000;
    }

    function vehiculoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'uid', 'patente', 'marca', 'modelo', 'año', 'color', 'clienteId',
          'estado', 'kilometraje', 'mecanicoId', 'fechaIngreso', 'observaciones', 'fechaLimite'])
        && d.id is int
        && textoValido(d.patente, 12)
        && textoValido(d.marca, 40)
        && textoValido(d.modelo, 40)
        && d['año'] is int
        && textoOpcional(d.color, 30)
        && d.clienteId is int
        && d.estado in ['INGRESADO', 'EN_REPARACION', 'TERMINADO', 'LISTO', 'ENTREGADO']
        && d.kilometraje is int && d.kilometraje >= 0
        && (d.mecanicoId == null || d.mecanicoId is int)
        && textoOpcional(d.fechaIngreso, 20)
        && textoOpcional(d.observaciones, 500)
        && textoOpcional(d.fechaLimite, 20);
    }

    function esCuentaPropietaria(tallerId, docId) {
      return docId == '1' && request.auth.uid == tallerId;
    }

    function usuarioValido(tallerId, docId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'uid', 'nombre', 'apellido', 'username', 'email', 'password', 'rol', 'activo'])
        && d.id is int
        && textoValido(d.nombre, 60)
        && textoValido(d.apellido, 60)
        && textoValido(d.username, 80)
        && textoOpcional(d.email, 80)
        && (textoValido(d.password, 200) || (d.password == '' && esCuentaPropietaria(tallerId, docId)))
        && d.rol in ['ADMIN', 'JEFE_TALLER', 'MECANICO', 'REPUESTO', 'DIAGNOSIS']
        && d.activo is bool;
    }

    function fallaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'uid', 'vehiculoId', 'x', 'y', 'descripcion', 'fecha'])
        && d.id is int
        && d.vehiculoId is int
        && d.x is number && d.y is number
        && textoValido(d.descripcion, 300)
        && textoOpcional(d.fecha, 20);
    }

    function diagnosticoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'uid', 'vehiculoId', 'descripcion', 'fecha'])
        && d.id is int
        && d.vehiculoId is int
        && textoValido(d.descripcion, 300)
        && textoOpcional(d.fecha, 20);
    }

    function tareaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'uid', 'vehiculoId', 'descripcion', 'completada'])
        && d.id is int
        && d.vehiculoId is int
        && textoValido(d.descripcion, 300)
        && d.completada is bool;
    }

    function costoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'uid', 'vehiculoId', 'descripcion', 'monto', 'fecha'])
        && d.id is int
        && d.vehiculoId is int
        && textoValido(d.descripcion, 200)
        && d.monto is number && d.monto > 0 && d.monto <= 100000000
        && textoOpcional(d.fecha, 20);
    }

    function presupuestoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'uid', 'vehiculoId', 'tratamientos', 'fechaCreacion',
          'aprobado', 'fechaAprobacion', 'adicionales'])
        && d.id is int
        && d.vehiculoId is int
        && d.tratamientos is list && d.tratamientos.size() <= 100
        && textoOpcional(d.fechaCreacion, 20)
        && d.aprobado is bool
        && textoOpcional(d.fechaAprobacion, 20)
        && d.adicionales is list && d.adicionales.size() <= 100;
    }

    function agendaComunValida(d) {
      return d.id is int
        && textoValido(d.clienteNombre, 120)
        && d.clienteEmail is string
        && d.clienteEmail.size() <= 120
        && d.clienteEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && textoValido(d.vehiculoPatente, 12)
        && textoOpcional(d.vehiculoDescripcion, 120)
        && d.inicio is timestamp
        && d.duracionMin is int && d.duracionMin >= 15 && d.duracionMin <= 720
        && d.estado in ['agendada', 'reprogramada', 'cancelada', 'realizada']
        && textoOpcional(d.eventId, 200)
        && textoOpcional(d.syncError, 300)
        && d.creadoEn is timestamp
        && d.actualizadoEn is timestamp;
    }

    function citaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'uid', 'clienteNombre', 'clienteEmail', 'vehiculoPatente',
          'vehiculoDescripcion', 'servicio', 'inicio', 'duracionMin', 'estado', 'eventId', 'syncError',
          'creadoEn', 'actualizadoEn'])
        && agendaComunValida(d)
        && textoValido(d.servicio, 120);
    }

    function intervencionValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'uid', 'ordenTrabajoId', 'clienteNombre', 'clienteEmail', 'vehiculoPatente',
          'vehiculoDescripcion', 'descripcion', 'mecanicoNombre', 'mecanicoEmail', 'inicio', 'duracionMin',
          'estado', 'eventId', 'syncError', 'creadoEn', 'actualizadoEn'])
        && agendaComunValida(d)
        && d.ordenTrabajoId is int
        && textoValido(d.descripcion, 120)
        && textoOpcional(d.mecanicoNombre, 120)
        && textoOpcional(d.mecanicoEmail, 120);
    }

    function tallerValido(tallerId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['nombre', 'ownerUid', 'codigo'])
        && textoValido(d.nombre, 80)
        && d.ownerUid == tallerId
        && textoValido(d.codigo, 8);
    }

    function cacheTiendasValida(docId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['radio', 'lat', 'lng', 'fecha', 'tiendas'])
        && d.radio is int && d.radio > 0 && d.radio <= 50000
        && string(d.radio) == docId
        && d.lat is number && d.lng is number
        && d.fecha is timestamp
        && d.tiendas is list && d.tiendas.size() <= 200;
    }

    match /codigos/{codigo} {
      allow get: if autenticado();
      allow list: if false;
      allow create: if noAnonimo()
        && request.resource.data.keys().hasOnly(['tallerId'])
        && request.resource.data.tallerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /talleres/{tallerId} {
      allow get: if autenticado();
      allow list: if false;
      allow create: if noAnonimo() && request.auth.uid == tallerId && tallerValido(tallerId);
      allow update: if noAnonimo() && request.auth.uid == tallerId && tallerValido(tallerId);
      allow delete: if false;

      match /clientes/{id} {
        allow read: if autenticado();
        allow create, update: if autenticado() && clienteValido();
        allow delete: if autenticado();
      }

      match /repuestos/{id} {
        allow read: if autenticado();
        allow create, update: if autenticado() && repuestoValido();
        allow delete: if autenticado();
      }

      match /vehiculos/{id} {
        allow read: if autenticado();
        allow create, update: if autenticado() && vehiculoValido();
        allow delete: if autenticado();
      }

      match /usuarios/{id} {
        allow read: if autenticado();
        allow create, update: if autenticado() && usuarioValido(tallerId, id);
        allow delete: if autenticado();
      }

      match /fallas/{id} {
        allow read: if autenticado();
        allow create, update: if autenticado() && fallaValida();
        allow delete: if autenticado();
      }

      match /diagnosticos/{id} {
        allow read: if autenticado();
        allow create, update: if autenticado() && diagnosticoValido();
        allow delete: if autenticado();
      }

      match /tareas/{id} {
        allow read: if autenticado();
        allow create, update: if autenticado() && tareaValida();
        allow delete: if autenticado();
      }

      match /costos/{id} {
        allow read: if autenticado();
        allow create, update: if autenticado() && costoValido();
        allow delete: if autenticado();
      }

      match /presupuestos/{id} {
        allow read: if autenticado();
        allow create, update: if autenticado() && presupuestoValido();
        allow delete: if autenticado();
      }

      match /citas/{id} {
        allow read: if autenticado();
        allow create, update: if autenticado() && citaValida();
        allow delete: if false;
      }

      match /intervenciones/{id} {
        allow read: if autenticado();
        allow create, update: if autenticado() && intervencionValida();
        allow delete: if false;
      }

      match /cacheTiendas/{radio} {
        allow read: if autenticado();
        allow create, update: if autenticado() && cacheTiendasValida(radio);
        allow delete: if autenticado();
      }
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
